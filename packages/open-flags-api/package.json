{
  "name": "open-flags-api",
  "version": "0.1.0",
  "description": "Open Flags API client: flag, coat of arms and PNG URLs keyed by ISO 3166 codes, with polyfills and en/es/zh name lookup",
  "keywords": [
    "flags",
    "svg",
    "png",
    "coat-of-arms",
    "iso-3166",
    "iso-3166-1",
    "iso-3166-2",
    "i18n",
    "api-client",
    "open-flags"
  ],
  "author": "shyaboi",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Flags-API/open-flags-npm-package.git",
    "directory": "packages/open-flags-api"
  },
  "bugs": {
    "url": "https://github.com/Open-Flags-API/open-flags-npm-package/issues"
  },
  "homepage": "https://github.com/Open-Flags-API/open-flags-npm-package/tree/main/packages/open-flags-api#readme",
  "main": "./dist/open-flags-api.cjs",
  "module": "./dist/open-flags-api.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/open-flags-api.umd.js",
  "jsdelivr": "./dist/open-flags-api.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/open-flags-api.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/open-flags-api.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  }
}
